{
  "name": "revenue-execution-os",
  "version": "0.1.0",
  "private": true,
  "description": "Revenue Execution OS \u2014 reconciles customer conversations against CRM, email, task, and commercial state.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npx vite --host 0.0.0.0 --port 8080",
    "build:dev": "cd apps/web && npx vite build && cd ../.. && rm -rf dist && cp -R apps/web/dist dist",
    "typecheck": "cd apps/web && npx tsc --noEmit",
    "build": "cd apps/web && npx vite build",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "smoke:hubspot": "npm run smoke:hubspot --workspace @revexec/api",
    "eval:system": "npm run eval:system --workspace @revexec/api",
    "eval:os": "npm run eval:os --workspace @revexec/api",
    "eval:arch-compare": "npm run eval:arch-compare --workspace @revexec/api",
    "generate:integration-key": "npm run generate:integration-key --workspace @revexec/api",
    "smoke:hubspot-write": "npm run smoke:hubspot-write --workspace @revexec/api",
    "eval:model-compare": "npm run eval:model-compare --workspace @revexec/api",
    "smoke:gmail": "npm run smoke:gmail --workspace @revexec/api",
    "smoke:gmail-draft": "npm run smoke:gmail-draft --workspace @revexec/api",
    "smoke:calendar": "npm run smoke:calendar --workspace @revexec/api",
    "smoke:fireflies": "npm run smoke:fireflies --workspace @revexec/api",
    "worker": "npm run worker --workspace @revexec/api",
    "predeploy:check": "npm run predeploy:check --workspace @revexec/api",
    "dev:worker": "npm run dev:worker --workspace @revexec/api",
    "assessment:hubspot:setup": "npm run assessment:hubspot:setup --workspace @revexec/api",
    "assessment:prepare": "npm run assessment:prepare --workspace @revexec/api",
    "assessment:cleanup": "npm run assessment:cleanup --workspace @revexec/api",
    "assessment:refresh-account": "npm run assessment:refresh-account --workspace @revexec/api",
    "evaluator:provision": "npm run evaluator:provision --workspace @revexec/api",
    "verify:step50": "npm run test --workspace @revexec/core && npm run test --workspace @revexec/api",
    "live:check": "npm run live:check --workspace @revexec/api",
    "live:test-writes": "npm run live:test-writes --workspace @revexec/api",
    "verify:step50-core": "npm run test --workspace @revexec/core && npm run test --workspace @revexec/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "railway": "^3.11.0"
  }
}
