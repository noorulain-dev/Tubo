# Runtime
NODE_ENV=development
LOG_LEVEL=info
AUDIT_LEVEL=info

# PostgreSQL (required for the DB phase; optional during phase 1)
DATABASE_URL=postgres://user:password@localhost:5432/revexec

# LLM provider (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agent budget
MAX_TOOL_CALLS=12

# Backend HTTP server (apps/api)
PORT=3000
AUTH_TOKEN=

# Frontend (apps/web) — base URL of the backend API
VITE_API_URL=http://localhost:3000
VITE_AUTH_TOKEN=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=

# HubSpot smoke test (npm run smoke:hubspot) — locate one synthetic company
HUBSPOT_SMOKE_COMPANY=
HUBSPOT_SMOKE_COMPANY_ID=

# Gmail OAuth 2.0 (authorize via Settings → Gmail → Authorize)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Redirect URI for the authorization callback (default http://localhost:3000/gmail/oauth/callback)
GMAIL_REDIRECT_URI=
# Google Calendar OAuth redirect URI (default http://localhost:3000/integrations/google-calendar/oauth/callback)
CALENDAR_REDIRECT_URI=

# Dedicated evaluator/demo account (npm run evaluator:provision).
# Credentials are server-side only — never stored in source, never exposed to the
# browser. Share them ONLY in private submission instructions, not public code.
EVALUATOR_EMAIL=
EVALUATOR_PASSWORD=
