# Runtime
NODE_ENV=development
LOG_LEVEL=info
AUDIT_LEVEL=info

# PostgreSQL (required for the DB phase; optional during phase 1)
DATABASE_URL=postgres://user:password@localhost:5432/revexec

# LLM provider (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agent budget
MAX_TOOL_CALLS=12

# Backend HTTP server (apps/api)
PORT=3000
AUTH_TOKEN=

# Frontend (apps/web) — base URL of the backend API
VITE_API_URL=http://localhost:3000
VITE_AUTH_TOKEN=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=
